msgid "plugins.generic.twoFactorAuth.displayName"
msgstr "Autenticazione a Due Fattori via Email (2FA)"

msgid "plugins.generic.twoFactorAuth.description"
msgstr "Aggiunge l'autenticazione a due fattori al processo di login tramite codice OTP inviato via email. Obbligatoria per tutti gli utenti. Conforme ACN e GDPR."

msgid "plugins.generic.twoFactorAuth.verify.title"
msgstr "Verifica identità"

msgid "plugins.generic.twoFactorAuth.verify.description"
msgstr "Ti abbiamo inviato un codice di verifica a 6 cifre all'indirizzo email registrato. Inseriscilo qui sotto. Il codice scade dopo 10 minuti."

msgid "plugins.generic.twoFactorAuth.verify.code.label"
msgstr "Codice di verifica"

msgid "plugins.generic.twoFactorAuth.verify.code.placeholder"
msgstr "000000"

msgid "plugins.generic.twoFactorAuth.verify.submit"
msgstr "Verifica e accedi"

msgid "plugins.generic.twoFactorAuth.verify.error.invalidCode"
msgstr "Codice non valido. Controlla l'email e riprova."

msgid "plugins.generic.twoFactorAuth.verify.error.locked"
msgstr "Troppi tentativi falliti. L'accesso è bloccato per 15 minuti. Riprova più tardi."

msgid "plugins.generic.twoFactorAuth.settings.requiredRoles.title"
msgstr "Ruoli che richiedono la verifica in due passaggi"

msgid "plugins.generic.twoFactorAuth.settings.requiredRoles.description"
msgstr "Seleziona i ruoli per cui è obbligatoria la verifica via email. Se nessun ruolo è selezionato, il 2FA è disabilitato per tutti gli utenti."

msgid "plugins.generic.twoFactorAuth.settings.role.siteAdmin"
msgstr "Amministratore del sito"

msgid "plugins.generic.twoFactorAuth.settings.role.manager"
msgstr "Gestore / Manager"

msgid "plugins.generic.twoFactorAuth.settings.role.manager.note"
msgstr "OMP: Press manager, Press editor, Editor di produzione · OJS: Journal manager, Editor in capo, Editor di produzione"

msgid "plugins.generic.twoFactorAuth.settings.role.subEditor"
msgstr "Editor di sezione / collana"

msgid "plugins.generic.twoFactorAuth.settings.role.subEditor.note"
msgstr "OMP: Editor di collana · OJS: Editor di sezione, Guest editor"

msgid "plugins.generic.twoFactorAuth.settings.role.reviewer"
msgstr "Revisore"

msgid "plugins.generic.twoFactorAuth.settings.role.reviewer.note"
msgstr "OMP: Revisore interno, Revisore esterno · OJS: Revisore esterno"

msgid "plugins.generic.twoFactorAuth.settings.role.assistant"
msgstr "Assistente editoriale"

msgid "plugins.generic.twoFactorAuth.settings.role.assistant.note"
msgstr "Copyeditor, Designer, Finanziatore, Indicizzatore, Layout editor, Marketing, Correttore di bozze, Componente del board editorale"

msgid "plugins.generic.twoFactorAuth.settings.role.author"
msgstr "Autore"

msgid "plugins.generic.twoFactorAuth.settings.role.author.note"
msgstr "OMP: Autore, Curatore del Libro, Autore di un capitolo, Traduttore · OJS: Autore, Traduttore"

msgid "plugins.generic.twoFactorAuth.settings.role.reader"
msgstr "Lettore"

msgid "plugins.generic.twoFactorAuth.settings.role.subscriptionManager"
msgstr "Gestore abbonamenti"

msgid "plugins.generic.twoFactorAuth.settings.role.subscriptionManager.note"
msgstr "Solo OJS"

msgid "plugins.generic.twoFactorAuth.email.subject"
msgstr "Codice di accesso per la tua area riservata"

msgid "plugins.generic.twoFactorAuth.email.body"
msgstr "Gentile {$name},\n\nil tuo codice di verifica per l'accesso è:\n\n    {$code}\n\nIl codice è valido per {$minutes} minuti.\n\nSe non hai richiesto l'accesso, ignora questa email."

msgid "plugins.generic.twoFactorAuth.email.footer"
msgstr "Questo messaggio è stato generato automaticamente. Non rispondere a questa email."
